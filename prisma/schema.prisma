// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(OPERATOR)
  avatarUrl String?
  createdAt DateTime @default(now())

  pos       PurchaseOrder[] @relation("CreatedBy")
  auditLogs AuditLog[]
}

enum UserRole {
  VIEWER
  OPERATOR
  MANAGER
  ADMIN
}

model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  country   String
  currency  String
  contact   String?
  email     String?
  memo      String?
  active    Boolean  @default(true)
  pos       PurchaseOrder[]
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  poNumber     String    @unique
  issueDate    DateTime
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  vendorId     String
  status       POStatus  @default(DRAFT)
  remarks      String?
  cancelReason String?

  items    POItem[]
  payments Payment[]
  invoices Invoice[]

  // 무역 파이프라인 연결
  tradeCase   TradeCase? @relation(fields: [tradeCaseId], references: [id])
  tradeCaseId String?

  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([issueDate, status])
  @@index([vendorId])
  @@index([tradeCaseId])
}

enum POStatus {
  DRAFT
  ISSUED
  PAID
  SHIPPED
  INVOICED
  COMPLETED
  CANCELLED
}

model POItem {
  id            String        @id @default(cuid())
  po            PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  poId          String
  productName   String
  specification String?
  quantity      Decimal
  unit          String
  unitPrice     Decimal
  currency      String
  totalAmount   Decimal
  sortOrder     Int           @default(0)
}

model Payment {
  id          String        @id @default(cuid())
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  poId        String
  installment Int
  ratio       Decimal
  payDate     DateTime
  currency    String
  amount      Decimal
  fxRate      Decimal?
  amountKRW   Decimal?
  taxInvoice  String?
  approved    Boolean       @default(false)
  approvedBy  String?
  approvedAt  DateTime?
}

enum InvoiceType {
  REGULAR    // 일반 청구 (P/O 연결)
  TRANSPORT  // 운송비 T(N)
  SAMPLE     // 샘플 대금 S(N)
}

model Invoice {
  id           String         @id @default(cuid())
  po           PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: Cascade)
  poId         String?
  invoiceNo    String         @unique
  invoiceDate  DateTime
  invoiceType  InvoiceType    @default(REGULAR)
  unitPriceJPY Decimal
  totalJPY     Decimal
  invoiceJPY   Decimal?   // 실 청구액 (부분 청구 등)
  ratio        Decimal
  memo         String?
  sourceFile   String?
  deposits     Deposit[]

  // 무역 파이프라인 연결
  tradeCase   TradeCase? @relation(fields: [tradeCaseId], references: [id])
  tradeCaseId String?

  @@index([tradeCaseId])
}

model Deposit {
  id          String   @id @default(cuid())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  depositDate DateTime
  amountJPY   Decimal
  fxRate      Decimal
  amountKRW   Decimal
}

model AuditLog {
  id        String      @id @default(cuid())
  table     String
  recordId  String
  action    AuditAction
  before    Json?
  after     Json?
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  ipAddress String?
  createdAt DateTime    @default(now())

  @@index([table, recordId])
  @@index([createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  EXPORT
}

model FxRate {
  id      String   @id @default(cuid())
  date    DateTime @unique
  usdKrw  Decimal
  jpyKrw  Decimal
  source  String   @default("BOK")
  fetched DateTime @default(now())
}

// ============================================================
// 무역 파이프라인 (신규 추가)
// ============================================================

enum TradeCaseStatus {
  DOCUMENTS_UPLOADED  // 문서 업로드 완료
  PARSED              // 파싱 완료
  REVIEWED            // 사람 검토 완료
  PO_CREATED          // 발주서 저장 완료
  SHIPPED             // 선적 완료
  INVOICED            // 청구서 발행 완료
  PAYMENT_PENDING     // 입금 대기
  COMPLETED           // 입금 완료
}

enum DocType {
  JP_PO        // 일본→한국 発注書 (NH-DH번호)
  KR_PO_INTL   // 한국→해외 발주서 (DHPO-(I))
  KR_PO_LOCAL  // 한국 국내 발주서 (DH(L))
  INVOICE_NOAH // NOAH 청구서 請求書 (DHPI-C(N))
  SHIPPING_DOC // 선적서류 Inv & P.L (Excel)
}

// 거래 묶음 — 폴더 하나 = TradeCase 하나
model TradeCase {
  id         String          @id @default(cuid())
  caseName   String          // "C-12_두바이쫀득쿠키"
  nhDhNumber String?         // 일본 발주번호 (핵심 연결 키)
  status     TradeCaseStatus @default(DOCUMENTS_UPLOADED)
  memo       String?

  documents      TradeCaseDocument[]
  shippingInfo   ShippingInfo?
  linkedPOs      PurchaseOrder[]
  linkedInvoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nhDhNumber])
  @@index([status])
}

// 업로드된 원본 파일 & 파싱 결과
model TradeCaseDocument {
  id          String    @id @default(cuid())
  tradeCase   TradeCase @relation(fields: [tradeCaseId], references: [id], onDelete: Cascade)
  tradeCaseId String

  docType    DocType // 문서 유형
  docNumber  String? // 추출된 문서번호
  fileName   String  // 원본 파일명
  filePath   String  // 서버 저장 경로
  parsedData Json    // 파싱 결과 전체
  confidence Float   @default(0) // 매칭 신뢰도 0~100
  verified   Boolean @default(false) // 사람이 확인했는지

  createdAt DateTime @default(now())

  @@index([tradeCaseId])
  @@index([docNumber])
}

// 선적 정보
model ShippingInfo {
  id          String    @id @default(cuid())
  tradeCase   TradeCase @relation(fields: [tradeCaseId], references: [id], onDelete: Cascade)
  tradeCaseId String    @unique

  portOfLoading   String    // "Incheon" / "Shekou" / "Xiamen"
  portOfDischarge String    // "Yokohama"
  carrier         String?   // 선사/선박명
  containerNos    String[]  // 컨테이너 번호 목록
  incoterms       String?   // "FOB" / "CIF"
  etd             DateTime? // 출항일
  eta             DateTime? // 도착일
  totalQty        Int?
  totalWeightKg   Decimal?
  totalCbm        Decimal?
}
